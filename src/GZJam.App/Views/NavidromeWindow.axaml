<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GZJam.App.ViewModels"
        x:Class="GZJam.App.Views.NavidromeWindow"
        x:DataType="vm:NavidromeViewModel"
        Width="720" Height="560" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        Title="Navidrome">
  <!-- Search the Navidrome server; a song is downloaded whole, then loaded on a deck or queued -->
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Classes="label" Text="NAVIDROME" Margin="0,0,0,8" />
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Song, artist or album" IsEnabled="{Binding IsSetUp}" />
      <Button x:Name="SearchButton" Grid.Column="1" Classes="hw" Content="SEARCH" MinWidth="88"
              Command="{Binding SearchCommand}" IsEnabled="{Binding !IsBusy}" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" x:Name="StatusText" Classes="setting-help" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="DownloadsButton" Classes="hw" Content="DOWNLOADS" Command="{Binding ShowDownloadsCommand}"
              ToolTip.Tip="The songs coming down from the server (Ctrl+Shift+J)" />
      <Button x:Name="SyncButton" Classes="hw" Content="SYNC LIBRARY" Command="{Binding SyncCommand}"
              IsEnabled="{Binding !IsBusy}"
              ToolTip.Tip="Put the server's songs and playlists in GZJam: the songs show in the song list and its search, and each playlist becomes one of GZJam's. They follow the server, so changes made to them here are undone at the next sync" />
      <Button x:Name="QueueButton" Classes="hw" Content="ADD TO QUEUE" Command="{Binding AddToQueueCommand}"
              IsEnabled="{Binding !IsBusy}" />
      <Button x:Name="DeckButton" Classes="hw" Content="LOAD ON DECK" Command="{Binding LoadOnDeckCommand}"
              IsEnabled="{Binding !IsBusy}" />
    </StackPanel>
    <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:NavidromeRow">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2">
            <StackPanel>
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding Length}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
